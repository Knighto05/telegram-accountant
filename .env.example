# Telegram
TELEGRAM_BOT_TOKEN=
# Your chat id. Leave 0 for setup mode: send /start to the bot and it replies with the id.
OWNER_CHAT_ID=0
TIMEZONE=Europe/Paris

# Proactive schedule (local time, HH:MM)
RECAP_TIME=21:30
WEEKLY_REPORT_DAY=SUN
WEEKLY_REPORT_TIME=18:00
# Monthly report fires on the 1st of each month at this time.
MONTHLY_REPORT_TIME=09:00

# LLM — set at least one key. Receipt photos need a vision-capable provider
# (anthropic, openai or xai — deepseek is text-only).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_MODEL=anthropic:claude-sonnet-4-6
# Comma-separated "provider:model" specs tried in order when the active model fails.
LLM_FALLBACKS=

ACCOUNTANT_DB_PATH=./data/accountant.db
# true = log outgoing messages instead of sending them.
DRY_RUN=false
